# Set custom font
font-family = "Berkeley Mono"
font-thicken = false

# Set font size
font-size = 14

# Increase the cell height
adjust-cell-height = 30%

# Set custom theme
theme = Kanagawa Wave

# Hide the title bar. To display it again, either remove the line below or set its value to 'server'.
# window-decoration = none
gtk-titlebar = false

# Hide mouse while typing
mouse-hide-while-typing = true

window-height=1080
window-width=1920
